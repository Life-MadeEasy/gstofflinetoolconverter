<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>GST Automation Tool v2.1</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f9; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .card { background: white; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); text-align: center; max-width: 500px; width: 90%; }
        h1 { color: #2c3e50; font-size: 24px; margin-bottom: 10px; }
        .upload-btn { background: #3498db; color: white; padding: 15px 30px; border-radius: 8px; cursor: pointer; display: inline-block; font-weight: bold; margin-top: 20px; }
        #status { margin-top: 20px; font-weight: 600; }
        .success { color: #27ae60; }
    </style>
</head>
<body>

<div class="card">
    <h1>GST Tool (Final Version)</h1>
    <p>Upload Excel to get 5 CSVs in a ZIP.<br><b>Includes: B2B, B2C, HSN (B2B/B2C), & Docs (Invoices + Credit Notes).</b></p>
    
    <label class="upload-btn" for="fileInput">Select Excel File</label>
    <input type="file" id="fileInput" hidden accept=".xlsx, .xls">
    
    <div id="status"></div>
</div>

<script>
    const fileInput = document.getElementById('fileInput');
    const status = document.getElementById('status');

    fileInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        status.innerText = "Processing...";
        const reader = new FileReader();

        reader.onload = async (event) => {
            try {
                const data = new Uint8Array(event.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const zip = new JSZip();

                zip.file("b2b,sez,de.csv", processB2B(workbook));
                zip.file("b2cs.csv", processB2CS(workbook));
                const hsn = processHSN(workbook);
                zip.file("hsn(b2b).csv", hsn.b2b);
                zip.file("hsn(b2c).csv", hsn.b2c);
                zip.file("docs.csv", processDocs(workbook));

                const content = await zip.generateAsync({ type: "blob" });
                const link = document.createElement("a");
                link.href = URL.createObjectURL(content);
                link.download = "GST_Offline_Import.zip";
                link.click();

                status.className = 'success';
                status.innerText = "✅ ZIP Downloaded Successfully!";
            } catch (err) {
                status.innerText = "❌ Error: " + err.message;
            }
        };
        reader.readAsArrayBuffer(file);
    });

    function findSheet(wb, name) {
        const found = wb.SheetNames.find(n => n.toUpperCase().includes(name.toUpperCase()));
        return found ? wb.Sheets[found] : null;
    }

    function findCol(headers, keywords) {
        return headers.findIndex(h => h && keywords.some(k => String(h).toLowerCase().includes(k.toLowerCase())));
    }

    function processB2B(wb) {
        const ws = findSheet(wb, 'B2B');
        const data = XLSX.utils.sheet_to_json(ws, { header: 1 });
        const hIdx = data.findIndex(r => r.some(c => String(c).includes("GSTIN")));
        const headers = data[hIdx];
        
        let out = "GSTIN/UIN of Recipient,Receiver Name,Invoice Number,Invoice date,Invoice Value,Place Of Supply,Reverse Charge,Applicable % of Tax Rate,Invoice Type,E-Commerce GSTIN,Rate,Taxable Value,Cess Amount\n";
        data.slice(hIdx + 1).forEach(r => {
            if (r[findCol(headers, ['GSTIN'])] && String(r[findCol(headers, ['GSTIN'])]).length > 5) {
                let rate = parseFloat(r[findCol(headers, ['Rate'])] || 0);
                if (rate < 1 && rate > 0) rate = Math.round(rate * 100);
                out += `${r[findCol(headers, ['GSTIN'])]},,${r[findCol(headers, ['Invoice Number'])]},${r[findCol(headers, ['Invoice date'])]},${r[findCol(headers, ['Invoice Value'])]},${r[findCol(headers, ['Place Of Supply'])]},N,,Regular B2B,,${rate},${r[findCol(headers, ['Taxable Value'])]},0\n`;
            }
        });
        return out;
    }

    function processB2CS(wb) {
        const ws = findSheet(wb, 'B2C');
        const data = XLSX.utils.sheet_to_json(ws, { header: 1 });
        const hIdx = data.findIndex(r => r.some(c => String(c).toLowerCase() === "place of supply"));
        const headers = data[hIdx];

        let out = "Type,Place Of Supply,Rate,Applicable % of Tax Rate,Taxable Value,Cess Amount,E-Commerce GSTIN\n";
        data.slice(hIdx + 1).forEach(r => {
            const pos = r[findCol(headers, ['Place of Supply'])];
            if (pos && String(pos).includes('-')) {
                out += `OE,${pos},${r[findCol(headers, ['Rate'])] || 0},,${r[findCol(headers, ['Taxable Value'])] || 0},,\n`;
            }
        });
        return out;
    }

    function processHSN(wb) {
        const ws = findSheet(wb, 'HSN');
        const data = XLSX.utils.sheet_to_json(ws, { header: 1 });
        const extract = (marker) => {
            let start = data.findIndex(r => r.some(c => String(c).toUpperCase() === marker));
            if (start === -1) return "";
            let headers = data[start + 1];
            let csv = "HSN,Description,UQC,Total Quantity,Total Value,Taxable Value,Integrated Tax Amount,Central Tax Amount,State/UT Tax Amount,Cess Amount,Rate\n";
            for (let i = start + 2; i < data.length; i++) {
                let r = data[i];
                let hsn = r[findCol(headers, ['Hsn/sac'])];
                if (!hsn || String(hsn).includes('Subtotal')) break;
                let tx = parseFloat(r[findCol(headers, ['Taxable Value'])] || 0);
                let igst = parseFloat(r[findCol(headers, ['IGST'])] || 0);
                let cgst = parseFloat(r[findCol(headers, ['CGST'])] || 0);
                let sgst = parseFloat(r[findCol(headers, ['SGST'])] || 0);
                csv += `${hsn},,NOS-NUMBERS,${r[findCol(headers, ['Quantity'])] || 0},${(tx+igst+cgst+sgst).toFixed(2)},${tx},${igst},${cgst},${sgst},0,${r[findCol(headers, ['Rate'])] || 0}\n`;
            }
            return csv;
        };
        return { b2b: extract('B2B'), b2c: extract('B2C') };
    }

    function processDocs(wb) {
        const ws = findSheet(wb, 'Docs Issued');
        const data = XLSX.utils.sheet_to_json(ws, { header: 1 });
        const hIdx = data.findIndex(r => r.some(c => String(c).includes("Doc From")));
        const headers = data[hIdx];

        let out = "Nature of Document,Sr. No. From,Sr. No. To,Total Number,Cancelled\n";
        data.slice(hIdx + 1).forEach(r => {
            const part = String(r[findCol(headers, ['Particulars'])] || '').toUpperCase();
            const from = r[findCol(headers, ['Doc From'])];
            if (from) {
                let docType = "";
                if (part.includes("INVOICE")) docType = "Invoices for outward supply";
                else if (part.includes("CREDIT NOTE")) docType = "Credit Note";

                if (docType) {
                    out += `"${docType}",${from},${r[findCol(headers, ['Doc To'])]},${r[findCol(headers, ['No. of Documents'])]},0\n`;
                }
            }
        });
        return out;
    }
</script>
</body>
</html>
